from llm_client import chat
from model_router import route_model
from team_events import events


class Agent:
    """A single team member: a name, role/system prompt, and conversation memory."""

    def __init__(
        self,
        name: str,
        role_prompt: str,
        model: str | None = None,
        temperature: float = 0.3,
    ):
        self.name = name
        self.role_prompt = role_prompt
        self.model = model
        self.temperature = temperature
        self.history = []

    def say(
        self,
        message: str,
        extra_context: str = "",
        *,
        route_attempt: int = 1,
        force_primary: bool = False,
        model_override: str | None = None,
    ) -> str:
        """
        Generate one agent response.

        Model routing occurs per call so repeated work can escalate without
        recreating the agent. model_override is a true per-call override.
        """

        # Existing constructor models are treated as the role's configured
        # baseline on the first attempt. Once escalation is requested, the
        # router is allowed to promote the call.
        explicit_model = None

        if (
            route_attempt <= 1
            and not force_primary
        ):
            explicit_model = (
                model_override
                or self.model
            )
        elif model_override:
            explicit_model = model_override

        route = route_model(
            self.name,
            attempt=route_attempt,
            force_primary=force_primary,
            explicit_model=explicit_model,
        )

        events.emit(
            "AGENT_STARTED",
            agent=self.name,
            message="Generating response...",
        )

        events.emit(
            "TEAM_TELEMETRY",
            routing_agent=self.name,
            routing_model=route.model,
            routing_tier=route.tier,
            routing_attempt=route_attempt,
            routing_escalated=route.escalated,
            fallback_agent="",
            fallback_from_model="",
            fallback_to_model="",
            fallback_reason="",
            fallback_active=False,
        )

        if route.escalated:
            events.emit(
                "TEAM_LOG",
                agent=self.name,
                message=(
                    f"Model route escalated to "
                    f"{route.model}."
                ),
            )

        messages = [
            {
                "role": "system",
                "content": self.role_prompt,
            }
        ]

        if extra_context:
            messages.append(
                {
                    "role": "system",
                    "content": extra_context,
                }
            )

        messages.append(
            {
                "role": "user",
                "content": message,
            }
        )

        try:
            response = chat(
                messages,
                model=route.model,
                temperature=self.temperature,
                agent_name=self.name,
            )

            self.history.append(
                {
                    "input": message,
                    "output": response,
                    "model": route.model,
                    "route_tier": route.tier,
                    "route_attempt": route_attempt,
                    "route_escalated": route.escalated,
                }
            )

            events.emit(
                "AGENT_COMPLETED",
                agent=self.name,
                message="Completed",
            )

            return response

        except Exception as exc:
            events.emit(
                "AGENT_FAILED",
                agent=self.name,
                message=f"{type(exc).__name__}: {exc}",
            )
            raise

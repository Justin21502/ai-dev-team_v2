# Copy this to .env. Real keys are ignored by git.
# In GitHub Codespaces you can also store GROQ_API_KEY as a repository secret.

GROQ_API_KEY=

# Model defaults. GPT-OSS 120B is the strong coding/reasoning model;
# GPT-OSS 20B is the faster model used for lightweight review work.
AI_TEAM_PRIMARY_MODEL=openai/gpt-oss-120b
AI_TEAM_FAST_MODEL=openai/gpt-oss-20b
AI_TEAM_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional: override every agent independently if desired.
# AI_TEAM_RESEARCHER_MODEL=openai/gpt-oss-20b
# AI_TEAM_ARCHITECT_MODEL=openai/gpt-oss-120b
# AI_TEAM_DEVELOPER_MODEL=openai/gpt-oss-120b
# AI_TEAM_REVIEWER_MODEL=openai/gpt-oss-20b
# AI_TEAM_SECURITY_MODEL=openai/gpt-oss-20b
# AI_TEAM_TESTER_MODEL=openai/gpt-oss-20b
# AI_TEAM_DEBUGGER_MODEL=openai/gpt-oss-120b

# Optional GPT-OSS reasoning level: low, medium, or high.
# Medium is the default when supported by the model.
# AI_TEAM_REASONING_EFFORT=medium

# Keep completions bounded to protect free-tier usage. Leave unset for model defaults.
# AI_TEAM_MAX_OUTPUT_TOKENS=12000

# Retry transient API errors. Model-not-found automatically falls back.
AI_TEAM_MAX_RETRIES=2
AI_TEAM_RETRY_BASE_SECONDS=2

# Workflow limits (kept conservative for free-tier use).
MAX_REVIEW_ITERATIONS=2
MAX_SECURITY_ITERATIONS=1
MAX_TEST_ITERATIONS=3
PYTEST_TIMEOUT_SECONDS=120

# Set false to skip web research.
ENABLE_RESEARCH=true

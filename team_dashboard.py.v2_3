"""Live terminal dashboard for the AI Dev Team."""

from __future__ import annotations

import os
import shutil
import sys
import time
from threading import Lock, Thread

from team_events import TeamEvent, events
from usage_tracker import tracker


AGENTS = [
    "Researcher",
    "Architect",
    "Developer",
    "Reviewer",
    "Security",
    "Tester",
    "Debugger",
]

ICONS = {
    "Researcher": "🔎",
    "Architect": "🏗️",
    "Developer": "💻",
    "Reviewer": "🔍",
    "Security": "🔐",
    "Tester": "🧪",
    "Debugger": "🐛",
}


class Dashboard:
    def __init__(self):
        self._lock = Lock()
        self.running = False
        self.current_agent = None
        self.status = {agent: "WAITING" for agent in AGENTS}
        self.messages = {agent: "" for agent in AGENTS}
        self.activity = []
        self.start_time = None
        self.run_number = None
        self.task = ""
        self.completed = False
        self.progress = 0
        self.telemetry = {
            "phase": "Starting",
            "review_round": 0,
            "review_max": 0,
            "security_round": 0,
            "security_max": 0,
            "test_attempt": 0,
            "test_max": 0,
            "pytest_status": "NOT RUN",
            "pytest_summary": "",
            "source_files": 0,
            "test_files": 0,
            "current_model": "",
        }
        self._refresh_thread = None
        self._stop_refresh = False
        self._alternate_screen = False

        events.subscribe(self.handle_event)

    def start(self, run_number=None):
        with self._lock:
            self.running = True
            self.start_time = time.time()
            self.run_number = run_number
            self.activity = []
            self.current_agent = None
            self.status = {agent: "WAITING" for agent in AGENTS}
            self.messages = {agent: "" for agent in AGENTS}
            self.completed = False
            self.progress = 0
            self.telemetry = {
                "phase": "Starting",
                "review_round": 0,
                "review_max": 0,
                "security_round": 0,
                "security_max": 0,
                "test_attempt": 0,
                "test_max": 0,
                "pytest_status": "NOT RUN",
                "pytest_summary": "",
                "source_files": 0,
                "test_files": 0,
                "current_model": "",
            }
            self._stop_refresh = False

        # Enter the terminal's alternate screen so the live dashboard
        # has its own screen and never floods the normal terminal history.
        if not self._alternate_screen:
            print("\033[?1049h\033[?25l\033[H", end="", flush=True)
            self._alternate_screen = True

        self.render()

        if self._refresh_thread is None or not self._refresh_thread.is_alive():
            self._refresh_thread = Thread(
                target=self._refresh_loop,
                daemon=True,
            )
            self._refresh_thread.start()

    def stop(self):
        with self._lock:
            self.running = False
            self.current_agent = None
            self._stop_refresh = True

        if self._refresh_thread is not None:
            self._refresh_thread.join(timeout=1.0)
            self._refresh_thread = None

        self.render()

        # Return to the normal terminal screen after the team finishes.
        if self._alternate_screen:
            print("\033[?25h\033[?1049l", end="", flush=True)
            self._alternate_screen = False

        if self.completed:
            totals = tracker.totals()

            summary = (
                f"✓ AI DEV TEAM — Run "
                f"{self.run_number if self.run_number is not None else '?'} "
                f"complete | "
                f"{totals.total_tokens:,} tokens | "
                f"{totals.calls} API calls | "
                f"${totals.estimated_cost:.6f}"
            )

            print(
                self._paint(summary, "1;92"),
                flush=True,
            )

    def _refresh_loop(self):
        while True:
            with self._lock:
                if self._stop_refresh:
                    break

            time.sleep(1.0)

            with self._lock:
                if self._stop_refresh:
                    break

            self.render()

    def handle_event(self, event: TeamEvent):
        with self._lock:
            if event.agent in self.status:
                if event.event_type == "AGENT_STARTED":
                    self.status[event.agent] = "WORKING"
                    self.current_agent = event.agent
                    self.messages[event.agent] = event.message

                    stage_progress = {
                        "Researcher": 8,
                        "Architect": 20,
                        "Developer": 38,
                        "Reviewer": 55,
                        "Security": 70,
                        "Tester": 86,
                        "Debugger": 90,
                    }
                    self.progress = max(
                        self.progress,
                        stage_progress.get(event.agent, self.progress),
                    )

                elif event.event_type == "AGENT_COMPLETED":
                    self.status[event.agent] = "DONE"
                    self.messages[event.agent] = event.message

                    completion_progress = {
                        "Researcher": 15,
                        "Architect": 30,
                        "Developer": 48,
                        "Reviewer": 64,
                        "Security": 79,
                        "Tester": 95,
                        "Debugger": 96,
                    }
                    self.progress = max(
                        self.progress,
                        completion_progress.get(event.agent, self.progress),
                    )

                    if self.current_agent == event.agent:
                        self.current_agent = None

                elif event.event_type == "AGENT_FAILED":
                    self.status[event.agent] = "FAILED"
                    self.messages[event.agent] = event.message

                    if self.current_agent == event.agent:
                        self.current_agent = None

            if event.agent and event.message:
                timestamp = event.timestamp[11:19] if len(event.timestamp) >= 19 else event.timestamp
                icon = ICONS.get(event.agent, "🤖")

                self.activity.append(
                    (timestamp, icon, event.agent, event.message)
                )

                self.activity = self.activity[-8:]

            elif event.event_type == "TEAM_LOG" and event.message:
                timestamp = event.timestamp[11:19] if len(event.timestamp) >= 19 else event.timestamp

                self.activity.append(
                    (timestamp, "ℹ️", "Team", event.message)
                )

                self.activity = self.activity[-8:]

            if event.event_type == "TEAM_TELEMETRY":
                for key, value in event.data.items():
                    if key in self.telemetry:
                        self.telemetry[key] = value

            if event.event_type == "TEAM_STARTED":
                self.running = True
                self.task = event.message or self.task
                self.completed = False
                self.progress = max(self.progress, 2)

            elif event.event_type == "TEAM_COMPLETED":
                self.running = False
                self.current_agent = None
                self.completed = True
                self.progress = 100

        # Rendering is intentionally controlled by the dashboard
        # refresh mechanism instead of every individual event.
        # This prevents the terminal from being cleared and redrawn
        # hundreds of times during a team run.

    def _format_time(self):
        if self.start_time is None:
            return "00:00:00"

        elapsed = int(time.time() - self.start_time)

        hours, remainder = divmod(elapsed, 3600)
        minutes, seconds = divmod(remainder, 60)

        return f"{hours:02}:{minutes:02}:{seconds:02}"

    def _status_symbol(self, status):
        return {
            "WAITING": "○",
            "WORKING": "●",
            "DONE": "✓",
            "FAILED": "✗",
        }.get(status, "?")

    def _fit(self, text, width):
        """Clip/pad plain dashboard text to an exact character width."""
        text = str(text).replace("\n", " ")
        if width <= 0:
            return ""

        if len(text) > width:
            if width >= 3:
                text = text[: width - 3] + "..."
            else:
                text = text[:width]

        return f"{text:<{width}}"

    def _paint(self, text, code):
        """Apply ANSI styling without affecting dashboard geometry."""
        if not sys.stdout.isatty() or os.environ.get("NO_COLOR") is not None:
            return text

        return f"\033[{code}m{text}\033[0m"

    def _status_color(self, status):
        return {
            "WAITING": "90",       # gray
            "WORKING": "1;96",     # bold cyan
            "DONE": "1;92",        # bold green
            "FAILED": "1;91",      # bold red
        }.get(status, "0")

    def _progress_bar(self, width):
        width = max(10, width)
        filled = round(width * self.progress / 100)
        return "█" * filled + "░" * (width - filled)

    def _stage_name(self, current):
        if self.completed:
            return "COMPLETE"

        if current:
            return {
                "Researcher": "Research",
                "Architect": "Architecture",
                "Developer": "Development",
                "Reviewer": "Code Review",
                "Security": "Security Review",
                "Tester": "Testing",
                "Debugger": "Debugging",
            }.get(current, current)

        return "Preparing next stage"

    def render(self):
        if not self.running and self.start_time is None:
            return

        with self._lock:
            statuses = dict(self.status)
            current = self.current_agent
            messages = dict(self.messages)
            activity = list(self.activity)
            task = self.task
            completed = self.completed
            progress = self.progress
            telemetry = dict(self.telemetry)

        usage = tracker.get_all()
        totals = tracker.totals()

        terminal_width = shutil.get_terminal_size((110, 30)).columns

        # Keep the dashboard readable in narrow terminals and prevent it from
        # becoming absurdly wide on giant monitors.
        width = max(90, min(132, terminal_width - 2))
        inner = width - 2

        left_width = max(32, min(38, inner // 3))
        right_width = inner - left_width - 1

        top = "╭" + "─" * inner + "╮"
        bottom = "╰" + "─" * inner + "╯"
        divider = "├" + "─" * inner + "┤"
        split_divider = (
            "├"
            + "─" * left_width
            + "┼"
            + "─" * right_width
            + "┤"
        )

        def full_row(text=""):
            return "│" + self._fit(text, inner) + "│"

        def split_row(left="", right=""):
            return (
                "│"
                + self._fit(left, left_width)
                + "│"
                + self._fit(right, right_width)
                + "│"
            )

        run_text = (
            f"RUN #{self.run_number}"
            if self.run_number is not None
            else "AI DEV TEAM"
        )

        header_left = " AI DEV TEAM"
        header_right = f"{run_text}   {self._format_time()}"
        gap = max(1, inner - len(header_left) - len(header_right))

        task_text = task or "Waiting for task..."

        lines = [
            top,
            full_row(header_left + " " * gap + header_right),
            full_row(""),
            full_row(" TASK  " + task_text),
            divider,
            split_row(" AGENTS", " ACTIVITY"),
            split_row("", ""),
        ]

        # Agent and activity sections share the same vertical space.
        activity_rows = activity[-7:]

        for index, agent in enumerate(AGENTS):
            status = statuses[agent]
            symbol = self._status_symbol(status)
            data = usage.get(agent)

            tokens = f"{data.total_tokens:,}" if data else "0"
            pointer = "▶" if agent == current else " "

            agent_text = (
                f"{pointer} {symbol} {agent:<12} "
                f"{status:<8} {tokens:>8} tok"
            )

            if index < len(activity_rows):
                timestamp, icon, activity_agent, message = activity_rows[index]
                activity_text = (
                    f" {timestamp}  {activity_agent:<10}  {message}"
                )
            else:
                activity_text = ""

            agent_row = split_row(agent_text, activity_text)

            status_fragment = f"{symbol} {agent:<12} {status:<8}"
            colored_fragment = self._paint(
                status_fragment,
                self._status_color(status),
            )

            agent_row = agent_row.replace(
                status_fragment,
                colored_fragment,
                1,
            )

            if agent == current:
                agent_row = agent_row.replace(
                    "▶",
                    self._paint("▶", "1;96"),
                    1,
                )

            lines.append(agent_row)

        lines.extend(
            [
                split_divider,
                split_row(" CURRENT", " RUN PROGRESS"),
                split_row("", ""),
            ]
        )

        if current:
            current_message = messages.get(current) or "Working..."
            current_line_1 = f" {current}"
            current_line_2 = f" {current_message}"
        elif completed:
            current_line_1 = " Build complete"
            current_line_2 = " All team work has finished."
        else:
            current_line_1 = " No agent currently generating."
            current_line_2 = ""

        stage = self._stage_name(current)

        bar_room = max(12, right_width - 16)
        bar = self._progress_bar(bar_room)

        progress_row = split_row(
            current_line_1,
            f" {bar} {progress:>3}%",
        )

        progress_color = "1;92" if completed else "1;96"

        progress_row = progress_row.replace(
            bar,
            self._paint(bar, progress_color),
            1,
        )

        lines.append(progress_row)

        lines.append(
            split_row(
                current_line_2,
                f" {stage}",
            )
        )

        model = telemetry.get("current_model") or "—"

        review_text = (
            f"{telemetry['review_round']}/{telemetry['review_max']}"
            if telemetry["review_max"]
            else "—"
        )

        security_text = (
            f"{telemetry['security_round']}/{telemetry['security_max']}"
            if telemetry["security_max"]
            else "—"
        )

        test_text = (
            f"{telemetry['test_attempt']}/{telemetry['test_max']}"
            if telemetry["test_max"]
            else "—"
        )

        pytest_status = telemetry.get("pytest_status") or "NOT RUN"

        lines.append(
            split_row(
                f" Model: {model}",
                (
                    f" Phase: {telemetry.get('phase', '—')}  |  "
                    f"Review {review_text}  |  "
                    f"Security {security_text}"
                ),
            )
        )

        lines.append(
            split_row(
                (
                    f" Files: {telemetry['source_files']} source  "
                    f"{telemetry['test_files']} test"
                ),
                (
                    f" Pytest {test_text}  |  "
                    f"{pytest_status}"
                ),
            )
        )

        pytest_summary = telemetry.get("pytest_summary") or ""

        if pytest_summary:
            lines.append(
                split_row(
                    "",
                    f" {pytest_summary}",
                )
            )

        if completed:
            banner = "✓ BUILD COMPLETE"
            padding = max(0, (inner - len(banner)) // 2)

            lines.extend(
                [
                    divider,
                    full_row(
                        " " * padding
                        + self._paint(banner, "1;92")
                    ),
                ]
            )

        lines.extend(
            [
                divider,
                full_row(
                    " USAGE   "
                    f"{totals.total_tokens:,} tokens"
                    f"   |   {totals.calls} API calls"
                    f"   |   Input {totals.input_tokens:,}"
                    f"   |   Output {totals.output_tokens:,}"
                    f"   |   ${totals.estimated_cost:.6f}"
                ),
                bottom,
            ]
        )

        # Render the entire frame in one terminal write. This reduces visible
        # flicker compared with dozens of individual print() calls.
        frame = "\033[H\033[J" + "\n".join(lines)

        frame = frame.replace(
            "AI DEV TEAM",
            self._paint("AI DEV TEAM", "1;96"),
            1,
        )

        frame = frame.replace(
            " TASK  ",
            self._paint(" TASK  ", "1;93"),
            1,
        )

        frame = frame.replace(
            " RUN PROGRESS",
            self._paint(" RUN PROGRESS", "1;96"),
            1,
        )

        sys.stdout.write(frame)
        sys.stdout.flush()



dashboard = Dashboard()

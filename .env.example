# AI Dev Team configuration
#
# Copy this file to .env and fill in your own credentials.
# Never commit the real .env file.

GROQ_API_KEY=

# Optional model overrides
# AI_TEAM_PRIMARY_MODEL=openai/gpt-oss-120b
# AI_TEAM_FAST_MODEL=openai/gpt-oss-20b
# AI_TEAM_DEFAULT_MODEL=openai/gpt-oss-120b
# AI_TEAM_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional runtime location.
# If unset in an installed package, AI Dev Team uses ~/.ai-dev-team.
# AI_TEAM_HOME=/path/to/ai-dev-team-data

# Optional behavior
# ENABLE_RESEARCH=true
# AI_TEAM_CONTEXT_MAX_CHARS=60000
# AI_TEAM_MAX_REVIEW_ITERATIONS=2
# AI_TEAM_MAX_SECURITY_ITERATIONS=2
# AI_TEAM_MAX_TEST_ITERATIONS=3
